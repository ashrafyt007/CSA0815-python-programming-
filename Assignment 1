def pairwise_merge(contacts):
    keys = [get_keys(c) for c in contacts]
    parent = list(range(len(keys)))

    def find(x):
        if parent[x] != x:
            parent[x] = find(parent[x])
        return parent[x]

    for i in range(len(keys)):
        for j in range(i + 1, len(keys)):
            if keys[i] & keys[j]:
                parent[find(i)] = find(j)

    return len({
        find(i) for i in range(len(keys)) if keys[i]
    }) + sum(1 for k in keys if not k)


def generate_data(size):
    random.seed(11)
    people = max(1, int(size / 2.5))

    numbers = [
        "9%09d" % random.randrange(10**9)
        for _ in range(people)
    ]

    formats = [
        lambda x: x,
        lambda x: "+91 %s %s" % (x[:5], x[5:]),
        lambda x: "0" + x,
        lambda x: "%s-%s" % (x[:5], x[5:])
    ]

    names = [
        "Dr. Ravi", "ravi kumar", "Meena S",
        "Arun", "Priya R", "Mr. Karthik"
    ]

    data = []

    for _ in range(size):
        person = random.randrange(people)

        data.append({
            "name": random.choice(names),
            "phones": [random.choice(formats)(numbers[person])],
            "emails": []
        })

    return data, people


print("\n%9s %14s %16s %16s" %
      ("contacts", "merged records", "dict merge ms", "pairwise ms"))

for size in (1000, 4000, 100000):
    contacts, people = generate_data(size)

    start = time.perf_counter()
    merged = merge_contacts(contacts)
    dict_time = time.perf_counter() - start

    if size <= 4000:
        start = time.perf_counter()
        count = pairwise_merge(contacts)
        pair_time = time.perf_counter() - start

        assert count == len(merged)
        pair_output = "%.1f" % (pair_time * 1e3)
    else:
        pair_output = "~%.0f s (est.)" % (
            pair_time / (4000**2) * size**2
        )

    print("%9d %14d %16.1f %16s" %
          (size, len(merged), dict_time * 1e3, pair_output))

