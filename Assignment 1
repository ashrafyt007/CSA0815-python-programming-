
import re
import time
import random

TITLES = {"dr", "mr", "mrs", "ms", "prof", "shri", "smt"}

def clean_phone(phone):
    digits = re.sub(r"\D", "", phone or "")
    return digits[-10:] if len(digits) >= 10 else ""

def clean_name(name):
    words = re.findall(r"[a-z]+", (name or "").lower())
    return " ".join(w for w in words if w not in TITLES)

def get_keys(contact):
    keys = set()

    for phone in contact.get("phones", []):
        number = clean_phone(phone)
        if number:
            keys.add("n:" + number)

    for email in contact.get("emails", []):
        email = email.strip().lower()
        if email:
            keys.add("e:" + email)

    return keys

def merge_contacts(contacts):
    records = {}
    lookup = {}
    counter = 0

    for contact in contacts:
        keys = get_keys(contact)
        matched = {lookup[k] for k in keys if k in lookup}

        if matched:
            record_id = min(matched)

            for old_id in matched - {record_id}:
                old = records.pop(old_id)

                for field in ("names", "phones", "emails"):
                    records[record_id][field].update(old[field])

                for phone in old["phones"]:
                    lookup["n:" + phone] = record_id

                for email in old["emails"]:
                    lookup["e:" + email] = record_id
        else:
            record_id = counter
            counter += 1
            records[record_id] = {
                "names": set(),
                "phones": set(),
                "emails": set()
            }

        current = records[record_id]

        name = clean_name(contact.get("name"))
        if name:
            current["names"].add(name)

        current["phones"].update(
            clean_phone(p) for p in contact.get("phones", [])
            if clean_phone(p)
        )

        current["emails"].update(
            e.strip().lower() for e in contact.get("emails", [])
            if e.strip()
        )

        for key in keys:
            lookup[key] = record_id

    return list(records.values())


