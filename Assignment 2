PAISE = D("0.01")
STD_FAT, STD_SNF, STEP = D("3.5"), D("8.5"), D("0.1")
BONUS_LIMIT_LITRES = D("500")
BONUS_PER_LITRE = D("0.50")

RATE_CARDS = {                       # the ONLY place where rates live
    "regular": {"base": D("30.00"), "fat": D("0.40"), "snf": D("0.30")},
    "summer":  {"base": D("32.00"), "fat": D("0.45"), "snf": D("0.30")},
}


def season_for_month(month):
    """Returns 'summer' for April-June (4..6), otherwise 'regular'."""
    return "summer" if 4 <= month <= 6 else "regular"


def money(x):
    """Rounds a Decimal to whole paise, halves going up."""
    return x.quantize(PAISE, rounding=ROUND_HALF_UP)


def rate_per_litre(fat, snf, season="regular"):
    """Returns Decimal Rs/litre; steps are pro-rata (7.5 steps allowed)."""
    card = RATE_CARDS[season]
    fat_steps = (D(str(fat)) - STD_FAT) / STEP
    snf_steps = (D(str(snf)) - STD_SNF) / STEP
    return money(card["base"] + fat_steps * card["fat"] + snf_steps * card["snf"])


def payout(litres, fat, snf, season="regular"):
    """Returns Decimal amount for one delivery, rounded to paise."""
    return money(D(str(litres)) * rate_per_litre(fat, snf, season))


def bonus(total_litres):
    """Returns the ten-day bonus: Rs 0.50 on ALL litres if litres > 500."""
    litres = D(str(total_litres))
    return money(litres * BONUS_PER_LITRE) if litres > BONUS_LIMIT_LITRES else D("0.00")


def ten_day_total(entries, season="regular"):
    """entries: (litres, fat, snf). Returns (litres, payments, bonus, grand)."""
    litres = sum((D(str(e[0])) for e in entries), D("0"))
    pay = sum((payout(l, f, s, season) for l, f, s in entries), D("0.00"))
    b = bonus(litres)
    return litres, pay, b, pay + b

